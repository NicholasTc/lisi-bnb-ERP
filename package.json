{
  "name": "lisi-bnb-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "overrides": { "@esbuild-kit/core-utils": { "esbuild": "0.28.2" } },
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx scripts/run.ts dev",
    "build": "next build",
    "start": "tsx scripts/run.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:integration": "tsx scripts/run.ts integration",
    "test:e2e": "tsx scripts/run.ts e2e",
    "db:generate": "tsx scripts/run.ts generate",
    "db:migrate": "tsx scripts/run.ts migrate",
    "db:migrate:test": "tsx scripts/run.ts migrate-test",
    "local:setup": "tsx scripts/setup-local.ts",
    "employee:provision": "tsx scripts/run.ts provision",
    "employee:disable": "tsx scripts/run.ts disable"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vite": "7.3.7"
  }
}
