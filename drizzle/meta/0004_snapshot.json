          "value": "\"customer_order\".\"expires_at\" > \"customer_order\".\"created_at\" AND \"customer_order\".\"expires_at\" <= \"customer_order\".\"created_at\" + interval '15 minutes' AND \"customer_order\".\"access_expires_at\" > \"customer_order\".\"created_at\" AND \"customer_order\".\"access_expires_at\" <= \"customer_order\".\"created_at\" + interval '24 hours'"
